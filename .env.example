# Copy this file to `.env` and paste your keys. `.env` is git-ignored.

# Speech-to-text providers
MURF_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Free Hugging Face read token (https://huggingface.co/settings/tokens).
# Needed for the gated AI4Bharat datasets (IndicVoices, Lahaja, Svarah): open each
# dataset page once while logged in and click "Agree" - access is granted instantly.
HF_TOKEN=

# Where datasets, models and run outputs are stored. Keep this OUTSIDE iCloud Drive
# so audio files do not consume iCloud storage.
ASRBENCH_HOME=~/asrbench-data
